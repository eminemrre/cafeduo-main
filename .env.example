# ==========================================
# CafeDuo Environment Configuration
# ==========================================

# Server Configuration
# Do not set NODE_ENV in root frontend/Vite .env files.
# Set it only in backend runtime or deployment env when needed.
PORT=3001
API_URL=http://localhost:3001
CLIENT_URL=http://localhost:3000

# Frontend Build Configuration (Vite)
# Keep empty for same-domain reverse proxy setup (/api and /socket.io).
# Set full URL (https://api.example.com) for split frontend/backend deployments.
VITE_API_BASE_URL=
VITE_SOCKET_URL=
VITE_APP_BASE_URL=
VITE_SENTRY_DSN=https://73f11435cd2950e7d9e1d6414d761224@o4510981891162112.ingest.de.sentry.io/4510981893521488

# ==========================================
# Database Configuration
# ==========================================
# Production: Use DATABASE_URL
# Local Dev: Use individual variables
DATABASE_URL=postgres://postgres:password@localhost:5432/cafeduo

# Alternative DB Config (fallback)
DB_USER=postgres
DB_HOST=localhost
DB_NAME=cafeduo
DB_PASSWORD=password
DB_PORT=5432

# Connection Pool Settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# ==========================================
# Redis Configuration
# ==========================================
# Local Dev: redis://localhost:6379
# Docker: redis://redis:6379
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ==========================================
# Security Configuration
# ==========================================
# IMPORTANT: Use at least 64 random bytes in production.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-64-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d
TRUST_PROXY=1

# Bcrypt
BCRYPT_ROUNDS=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
API_RATE_LIMIT_WINDOW_MS=900000
API_RATE_LIMIT_MAX_REQUESTS=600
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX_REQUESTS=20
AUTH_REGISTER_RATE_LIMIT_MAX_REQUESTS=10
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX_REQUESTS=6
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX_REQUESTS=12
RATE_LIMIT_STORE=redis
RATE_LIMIT_REDIS_PREFIX=cafeduo:ratelimit
RATE_LIMIT_PASS_ON_STORE_ERROR=false

# Token blacklist behavior when Redis lookup fails
BLACKLIST_FAIL_MODE=closed

# Bootstrap admin account
# If BOOTSTRAP_ADMIN_PASSWORD is empty, admin upsert is skipped (no insecure default).
BOOTSTRAP_ADMIN_EMAILS=emin3619@gmail.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-admin-password
# Optional alias read by server.js when BOOTSTRAP_ADMIN_EMAILS is not set.
ADMIN_EMAILS=

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Accounts that check in without the café's location (geofence) verification.
# Comma separated usernames, case-insensitive. Empty = everybody is verified.
CHECKIN_LOCATION_EXEMPT_USERS=test102
COOKIE_DOMAIN=

# Google OAuth (server logs "MISSING ❌" on boot if both are empty; OAuth silently disabled)
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# reCAPTCHA (currently not enforced; leave empty unless wiring it up)
RECAPTCHA_SECRET_KEY=

# ==========================================
# Email Configuration (Optional)
# ==========================================
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=true forces TLS on connect (port 465). Leave unset to auto-detect.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@cafeduo.com
# SMTP timeout knobs read by emailService.js (defaults in code; uncomment to override).
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=20000
# SMTP_SEND_TIMEOUT_MS=20000
# SMTP_SEND_RETRIES=2
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# Public URL used in password-reset emails (falls back to APP_BASE_URL, then CLIENT_URL).
PUBLIC_APP_URL=
FRONTEND_URL=

# ==========================================
# Logging
# ==========================================
LOG_LEVEL=debug
LOG_FILE=logs/app.log
REQUEST_LOG_SLOW_MS=1200

# ==========================================
# Reverse Proxy / Domain (VPS + Caddy)
# ==========================================
SITE_ADDRESS=
ACME_EMAIL=
APP_BASE_URL=http://localhost:5173

# ==========================================
# Sentry APM Monitoring
# ==========================================
SENTRY_DSN=https://73f11435cd2950e7d9e1d6414d761224@o4510981891162112.ingest.de.sentry.io/4510981893521488

# ==========================================
# Feature Flags
# ==========================================
ENABLE_EMAIL_VERIFICATION=false

# ==========================================
# Version Metadata
# ==========================================
# Backend exposes these at /api/meta/version and on the build banner.
# Set automatically by the deploy workflow; leave blank for local development.
APP_VERSION=
APP_BUILD_TIME=
VITE_APP_VERSION=
VITE_BUILD_TIME=
